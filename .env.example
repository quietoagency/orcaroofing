# Local dev DB (docker compose up -d). Copy to .env.local, which overrides .env.
DATABASE_URL=postgresql://orca:orca@localhost:5432/orcaroofing
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Cloudflare Turnstile (test key: 1x00000000000000000000AA)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
